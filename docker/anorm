#!/usr/bin/env bash
#
# anorm — drive the PHP 7.4 development container from the host.
#
# Everything is relative to this script, so it works from any directory and from
# any worktree:
#
#   docker/anorm up            # start PHP + MariaDB (installs vendor/ on first run)
#   docker/anorm test          # run the PHPUnit suite in the container
#   docker/anorm shell         # a shell in /workspace as the host user
#
# Run `docker/anorm help` for the full list.

set -euo pipefail

DOCKER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$DOCKER_DIR/.." && pwd)"
COMPOSE_FILE="$DOCKER_DIR/docker-compose.yml"
ENV_FILE="$DOCKER_DIR/.env"

export PROJECT_ROOT

# Per-checkout overrides (ports, project name). Optional: `anorm init` writes one.
if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
fi

# One stack per checkout by default, keyed on the directory name, so a worktree
# never collides with the main checkout's containers or volumes.
if [ -z "${COMPOSE_PROJECT_NAME:-}" ]; then
    slug="$(basename "$PROJECT_ROOT" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g')"
    COMPOSE_PROJECT_NAME="anorm-${slug}"
fi
export COMPOSE_PROJECT_NAME

# The container's "dev" user is built to match whoever runs this script.
export USER_UID="${USER_UID:-$(id -u)}"
export USER_GID="${USER_GID:-$(id -g)}"

export DB_PORT="${DB_PORT:-3316}"
export PMA_PORT="${PMA_PORT:-8096}"

# Anorm's supported floor, and what this stack is for. Override to check the
# same checkout against a newer interpreter — see `anorm help`.
export PHP_VARIANT="${PHP_VARIANT:-7.4-cli}"

DB_NAME="${DB_NAME:-anorm_test}"
DB_USER="${DB_USER:-dev}"
DB_PASS="${DB_PASS:-dev}"
DB_ROOT_PASSWORD="${DB_ROOT_PASSWORD:-root}"
export DB_NAME DB_USER DB_PASS DB_ROOT_PASSWORD

APP_SERVICE=app

# composer.json, phpunit.xml, phpcs.xml, phpstan.neon, src/, test/, tools/ and
# vendor/ all live at the checkout root, which is the bind mount itself.
CONTAINER_WORKDIR=/workspace

# ----------------------------------------------------------------------------
# helpers
# ----------------------------------------------------------------------------

die() {
    printf 'anorm: %s\n' "$*" >&2
    exit 1
}

info() {
    printf '\033[36m==>\033[0m %s\n' "$*"
}

compose() {
    docker compose -f "$COMPOSE_FILE" --project-directory "$DOCKER_DIR" "$@"
}

# Run a command inside the app container as the host user, from the checkout root.
# -T because agents and scripts pipe this; there is no TTY to allocate.
app_exec() {
    compose exec -T -u "$USER_UID:$USER_GID" -w "$CONTAINER_WORKDIR" "$APP_SERVICE" "$@"
}

app_running() {
    [ -n "$(compose ps -q "$APP_SERVICE" 2>/dev/null)" ] \
        && [ "$(docker inspect -f '{{.State.Running}}' "$(compose ps -q "$APP_SERVICE")" 2>/dev/null)" = "true" ]
}

# Make `anorm test` work from cold, without a separate `anorm up` first.
ensure_up() {
    if ! app_running; then
        info "stack is not running — starting it"
        cmd_up
    fi
}

port_in_use() {
    # ss/lsof/netstat are not guaranteed to be installed; bash's /dev/tcp is.
    # A successful connect means something is already listening there.
    (exec 3<>"/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1 || return 1
    exec 3<&- 3>&-
    return 0
}

find_free_port() {
    local port="$1"
    while port_in_use "$port"; do
        port=$((port + 1))
    done
    printf '%s' "$port"
}

# ----------------------------------------------------------------------------
# commands
# ----------------------------------------------------------------------------

cmd_init() {
    if [ -f "$ENV_FILE" ] && [ "${1:-}" != "--force" ]; then
        die ".env already exists at $ENV_FILE (pass --force to overwrite)"
    fi

    info "probing for free ports"
    local db_port pma_port
    db_port="$(find_free_port "$DB_PORT")"
    pma_port="$(find_free_port "$PMA_PORT")"

    # Re-running with --force (e.g. because a port went stale) must not discard
    # anything added to .env by hand. Keep any KEY=value line whose key isn't
    # one this command itself generates.
    local generated_keys='^(COMPOSE_PROJECT_NAME|DB_PORT|PMA_PORT)='
    local preserved=""
    if [ -f "$ENV_FILE" ]; then
        preserved="$(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$ENV_FILE" | grep -vE "$generated_keys" || true)"
    fi

    cat > "$ENV_FILE" <<EOF
# Generated by \`docker/anorm init\` on $(date -u +%Y-%m-%dT%H:%M:%SZ).
# Local overrides for this checkout — not tracked by git.

COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME

DB_PORT=$db_port
PMA_PORT=$pma_port
EOF

    if [ -n "$preserved" ]; then
        {
            printf '\n# Preserved from the previous %s (not written by init):\n' "$(basename "$ENV_FILE")"
            printf '%s\n' "$preserved"
        } >> "$ENV_FILE"
    fi

    info "wrote $ENV_FILE (db=$db_port phpmyadmin=$pma_port)"
}

cmd_up() {
    local build_args=() profile_args=()
    for arg in "$@"; do
        case "$arg" in
            --build) build_args+=(--build) ;;
            --tools) profile_args+=(--profile tools) ;;
            *) die "unknown option for up: $arg" ;;
        esac
    done

    # Fail with an actionable message instead of docker's raw bind error.
    if ! app_running && port_in_use "$DB_PORT"; then
        die "port DB_PORT=$DB_PORT is already in use.
Run 'docker/anorm init' to write docker/.env with free ports, or set it yourself."
    fi

    info "starting stack '$COMPOSE_PROJECT_NAME' (php $PHP_VARIANT)"
    compose "${profile_args[@]}" up -d "${build_args[@]}"

    # On a fresh checkout the entrypoint installs Composer dependencies before
    # anything else can run, so this can legitimately take a couple of minutes.
    info "waiting for vendor/ to be installed"
    local waited=0
    until compose exec -T "$APP_SERVICE" test -f /workspace/vendor/autoload.php >/dev/null 2>&1; do
        waited=$((waited + 2))
        if [ "$waited" -ge 300 ]; then
            die "vendor/ did not appear within 300s — check 'docker/anorm logs app'"
        fi
        sleep 2
    done

    cmd_info
}

cmd_down() {
    info "stopping stack '$COMPOSE_PROJECT_NAME'"
    compose --profile tools down "$@"
}

cmd_info() {
    # The running container is the authority: PHP_VARIANT says what the next
    # `up --build` would produce, which is not necessarily what is running now.
    local php_line="php:$PHP_VARIANT configured, stack not running"
    if app_running; then
        php_line="$(app_exec php -r 'echo PHP_VERSION;' 2>/dev/null || echo unknown) running"
        php_line="$php_line, php:$PHP_VARIANT configured"
    fi
    cat <<EOF

  Stack       $COMPOSE_PROJECT_NAME
  PHP         $php_line
  MariaDB     127.0.0.1:${DB_PORT}  (database $DB_NAME, user $DB_USER / $DB_PASS)
  phpMyAdmin  http://localhost:${PMA_PORT}/   (start with: docker/anorm up --tools)

EOF
}

cmd_test() {
    ensure_up
    if [ $# -eq 0 ]; then
        # The project's own fast path: no coverage, Xdebug off.
        app_exec env XDEBUG_MODE=off composer test:quick
    else
        # Extra args mean "I want to target something specific" — go straight to
        # PHPUnit, which composer scripts cannot forward arguments to cleanly.
        app_exec env XDEBUG_MODE=off vendor/bin/phpunit -c phpunit-no-coverage.xml "$@"
    fi
}

cmd_test_full() {
    ensure_up
    # `composer test` uses phpunit.xml, which declares coverage reports; without
    # a coverage driver PHPUnit warns and, with failOnWarning="true", fails.
    app_exec env XDEBUG_MODE=coverage composer test
}

cmd_coverage() {
    ensure_up
    app_exec env XDEBUG_MODE=coverage composer test:coverage
}

cmd_ci() {
    ensure_up
    app_exec env XDEBUG_MODE=coverage composer ci
}

cmd_quality() {
    ensure_up
    app_exec composer quality
}

cmd_analyze() {
    ensure_up
    app_exec composer analyze
}

cmd_cs() {
    ensure_up
    case "${1:-check}" in
        check) app_exec composer cs:check ;;
        fix) app_exec composer cs:fix ;;
        *) die "usage: anorm cs [check|fix]" ;;
    esac
}

cmd_composer() {
    ensure_up
    app_exec composer "$@"
}

cmd_php() {
    ensure_up
    app_exec php "$@"
}

cmd_exec() {
    [ $# -gt 0 ] || die "usage: anorm exec <command> [args...]"
    ensure_up
    app_exec "$@"
}

cmd_shell() {
    ensure_up
    compose exec -u "$USER_UID:$USER_GID" -w "$CONTAINER_WORKDIR" "$APP_SERVICE" bash
}

cmd_root_shell() {
    ensure_up
    compose exec -u root -w "$CONTAINER_WORKDIR" "$APP_SERVICE" bash
}

cmd_mysql() {
    ensure_up
    compose exec db mariadb -uroot -p"$DB_ROOT_PASSWORD" "$@"
}

cmd_db_reset() {
    ensure_up
    # The suite builds its own schema in setUpBeforeClass, so dropping the
    # database is enough — nothing here has to re-create tables. Foreign keys
    # left behind by DynamicForeignKey_Test are the usual reason to want this.
    info "dropping and recreating $DB_NAME"
    compose exec -T db mariadb -uroot -p"$DB_ROOT_PASSWORD" -e \
        "DROP DATABASE IF EXISTS \`$DB_NAME\`;
         CREATE DATABASE \`$DB_NAME\`;
         GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$DB_USER'@'%';
         FLUSH PRIVILEGES;"
    info "done — the test suite recreates the schema on next run"
}

cmd_help() {
    cat <<'EOF'
anorm — drive the PHP 7.4 development container from the host.

Usage: docker/anorm <command> [args...]

Stack
  init [--force]     Write docker/.env pinning this checkout to free ports
  up [--build]       Start PHP + MariaDB (add --tools for phpMyAdmin)
  down [-v]          Stop the stack (-v also deletes the database volume)
  build              Rebuild the app image
  rebuild            Rebuild the app image from scratch
  ps                 Show container status
  logs [service]     Follow container logs
  info               Print the PHP version, database port and credentials

Testing and quality
  test [args...]     PHPUnit; no args runs `composer test:quick`,
                     any args are passed straight to phpunit
  test:full          `composer test` (phpunit.xml, with coverage reports)
  coverage           PHPUnit with Xdebug coverage (composer test:coverage)
  ci                 The full CI run: tests with clover + phpcs + phpstan
  quality            phpcs + phpstan (composer quality)
  analyze            phpstan only
  cs [check|fix]     Code style check or fix

Inside the container (as the host user, from /workspace)
  composer <args>    Run Composer
  php <args>         Run PHP
  exec <cmd>         Run an arbitrary command
  shell              Interactive bash shell
  root-shell         Interactive bash shell as root

Database
  mysql [args]       mariadb client as root inside the db container
  db-reset           Drop and recreate the test database

Checking another PHP version
  The image defaults to php:7.4-cli, the floor Anorm supports. To run the same
  checkout against a newer interpreter, rebuild with PHP_VARIANT set:

    PHP_VARIANT=8.3-cli docker/anorm up --build
    docker/anorm test
    PHP_VARIANT=7.4-cli docker/anorm up --build   # back to the floor

  This replaces the running container rather than adding a second one, and
  vendor/ is shared between them — run `docker/anorm composer install` after
  switching if a dependency resolves differently.

Examples
  docker/anorm up --build
  docker/anorm test
  docker/anorm test --filter FieldSelection_Test
  docker/anorm test test/anorm/Relationship
  XDEBUG_MODE=debug docker/anorm php -r 'var_dump(PHP_VERSION);'
EOF
}

# ----------------------------------------------------------------------------

command -v docker >/dev/null 2>&1 || die "docker is not installed or not on PATH"
docker compose version >/dev/null 2>&1 || die "the docker compose plugin is required"

cmd="${1:-help}"
shift || true

case "$cmd" in
    init) cmd_init "$@" ;;
    up|start) cmd_up "$@" ;;
    down|stop) cmd_down "$@" ;;
    build) compose build "$@" ;;
    rebuild) compose build --no-cache "$@" ;;
    restart) compose restart "$@" ;;
    ps|status) compose ps "$@" ;;
    logs) compose logs -f "$@" ;;
    info|url) cmd_info ;;
    test) cmd_test "$@" ;;
    test:full|test-full) cmd_test_full ;;
    coverage) cmd_coverage ;;
    ci) cmd_ci ;;
    quality) cmd_quality ;;
    analyze|analyse) cmd_analyze ;;
    cs) cmd_cs "$@" ;;
    composer) cmd_composer "$@" ;;
    php) cmd_php "$@" ;;
    exec) cmd_exec "$@" ;;
    shell|bash) cmd_shell ;;
    root-shell) cmd_root_shell ;;
    mysql) cmd_mysql "$@" ;;
    db-reset) cmd_db_reset ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown command '$cmd' — run 'docker/anorm help'" ;;
esac
